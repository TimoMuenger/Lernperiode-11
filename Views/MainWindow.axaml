<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:FinanzManager.ViewModels"
        xmlns:sys="using:System"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="FinanzManager.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="FinanzManager">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>
<StackPanel>
    <TextBlock Text="Finanz Manager" HorizontalAlignment="Center" VerticalAlignment="Top" FontWeight="Bold" FontSize="20"> </TextBlock>
    <TextBlock Text="Enter amount to add to your balance:" VerticalAlignment="Center" HorizontalAlignment="Center"/>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="5" Margin="5">
        <TextBox Width="120" Text="{Binding AmountInput}"/>
        <Button Content="Income" Command="{Binding AddIncomeCommand}"/>
        <Button Content="Expense" Command="{Binding AddExpenseCommand}"/>
    </StackPanel>
    <TextBlock Text="{Binding ErrorMessage}" Foreground="Red" HorizontalAlignment="Center"/>
    <Grid ShowGridLines="False" Margin="5" VerticalAlignment="Center" HorizontalAlignment="Center" 
          ColumnDefinitions="150, 150" ColumnSpacing="0"
          RowDefinitions="25, 35">
          <TextBlock Text="Total Income:" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0"/>
          <TextBlock Text="Total Expenses:" Grid.Row="0" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0"/>
          <TextBlock Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center" Text="{Binding TotalExpenses, StringFormat='{}{0:0.00} CHF'}"> </TextBlock>
          <TextBlock Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Center" Text="{Binding TotalIncome, StringFormat='{}{0:0.00} CHF'}"> </TextBlock>
    </Grid>
    <TextBlock Text="Total Balance:" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0"/>
    <TextBlock VerticalAlignment="Center" HorizontalAlignment="Center" Text="{Binding Balance, StringFormat='{}{0:0.00} CHF'}"> </TextBlock>
    <ItemsControl ItemsSource="{Binding Transactions}" HorizontalAlignment="Center" Margin="5">
        <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="sys:Decimal">
                <TextBlock Text="{Binding StringFormat='{}{0:0.00} CHF'}" HorizontalAlignment="Center"/>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
</StackPanel>
</Window>
